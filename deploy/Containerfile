ARG BASE_IMAGE
FROM ${BASE_IMAGE} AS shiny_server_build
USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential ca-certificates curl git python3 xz-utils \
    && rm -rf /var/lib/apt/lists/*
COPY deploy/harden-base.sh /opt/islet-server-build/harden-base.sh
COPY deploy/tests/smoke-shiny-server.py /opt/islet-server-build/smoke-shiny-server.py
COPY deploy/r-worker.py /opt/islet-server-build/r-worker.py
COPY deploy/shiny-server.conf /opt/islet-server-build/shiny-server.conf
# The upstream permission-denial tests and real-R tests must run without root.
USER shiny
RUN bash /opt/islet-server-build/harden-base.sh \
      /tmp/islet-shiny-server /tmp/islet-shiny-server-evidence \
    && python3 /opt/islet-server-build/smoke-shiny-server.py \
      /tmp/islet-shiny-server /tmp/islet-shiny-server-evidence/staged-smoke.json \
      /opt/islet-server-build/shiny-server.conf /opt/islet-server-build/r-worker.py

FROM ${BASE_IMAGE}

ARG BASE_IMAGE
ARG OCI_CREATED=""
ARG OCI_REVISION="unknown"
ARG OCI_VERSION="development"

LABEL org.opencontainers.image.title="Islet Explorer" \
      org.opencontainers.image.description="Reviewer-facing pancreatic islet explorer for UFRC PubApps" \
      org.opencontainers.image.source="https://github.com/smith6jt-cop/Islet-Explorer" \
      org.opencontainers.image.base.name="${BASE_IMAGE}" \
      org.opencontainers.image.created="${OCI_CREATED}" \
      org.opencontainers.image.revision="${OCI_REVISION}" \
      org.opencontainers.image.version="${OCI_VERSION}"

USER root

ENV DEBIAN_FRONTEND=noninteractive \
    RETICULATE_PYTHON=/opt/islet-explorer-py/bin/python \
    PYTHONNOUSERSITE=1 \
    ISLET_RUNTIME_MODE=production \
    ISLET_ENABLE_AI=FALSE \
    SHOW_STATISTICS_TAB=0 \
    SHOW_INFLAMMATION_TAB=0 \
    DEBUG_CREDENTIALS=0 \
    VIEWER_DEBUG=0 \
    OMP_NUM_THREADS=1 \
    OPENBLAS_NUM_THREADS=1 \
    MKL_NUM_THREADS=1 \
    NUMEXPR_NUM_THREADS=1

# Build from the repository root with deploy/containerignore. The image contains
# application code and dependencies only; scientific data and OME-TIFFs are
# mounted read-only by the PubApps Quadlet unit.
COPY scripts/install_shiny_deps.R /opt/islet-explorer-build/install_shiny_deps.R
COPY scripts/verify_release_data.R /srv/islet-explorer/scripts/verify_release_data.R
COPY deploy/install-production-r-deps.R /opt/islet-explorer-build/install-production-r-deps.R
COPY deploy/requirements-python.lock /opt/islet-explorer-build/requirements-python.lock

RUN set -eux; \
    apt-get update; \
    apt-get upgrade -y --no-install-recommends; \
    apt-get install -y --no-install-recommends \
      build-essential cmake curl gfortran git pkg-config \
      python3 python3-dev python3-pip python3-venv xz-utils \
      libcurl4-openssl-dev libfontconfig1-dev libfribidi-dev \
      libgdal-dev libgeos-dev libhdf5-dev libharfbuzz-dev \
      libjpeg-dev libmagick++-dev libnlopt-dev libpng-dev \
      libproj-dev libssl-dev libtiff-dev libudunits2-dev libxml2-dev; \
    apt-get remove -y shiny-server; \
    rm -rf /opt/shiny-server /var/lib/apt/lists/*

COPY --from=shiny_server_build --chown=root:root /tmp/islet-shiny-server /opt/shiny-server
COPY --from=shiny_server_build --chown=root:root /tmp/islet-shiny-server-evidence /opt/islet-explorer-build/shiny-server
RUN set -eux; \
    ln -sf /opt/shiny-server/bin/shiny-server /usr/bin/shiny-server; \
    test -x /usr/bin/pandoc; \
    /usr/bin/shiny-server --version; \
    Rscript -e 'stopifnot(as.character(getRversion()) == "4.5.1")'

# The existing application manifest supplies the core R stack. The production
# installer additionally makes destiny and DuckDB mandatory and verifies their
# release versions instead of allowing a best-effort install.
RUN Rscript /opt/islet-explorer-build/install-production-r-deps.R

# Remove unused system Python packaging tools only after all installs. Avoid
# autoremove so scientific shared libraries remain; bound dependent removals to
# the reviewed build tools and verify the isolated runtime after cleanup.
RUN set -eux; \
    python3 -m venv /opt/islet-explorer-py; \
    /opt/islet-explorer-py/bin/python -m pip install --no-cache-dir 'pip==25.3'; \
    /opt/islet-explorer-py/bin/python -m pip install --no-cache-dir \
      --requirement /opt/islet-explorer-build/requirements-python.lock; \
    apt-get -s remove python3-pip python3-setuptools python3-mako python3-wheel \
      > /opt/islet-explorer-build/system-build-tools-removal.txt; \
    awk '$1 == "Remv" { sub(/:.*/, "", $2); if ($2 !~ /^(python3-pip|python3-setuptools|python3-mako|python3-wheel|gobject-introspection|gobject-introspection-bin|libgirepository-1[.]0-dev|libgirepository1[.]0-dev|librsvg2-dev|libmagick\+\+-dev|libmagick\+\+-6[.]q16-dev|libmagickcore-6[.]q16-dev|libmagickwand-6[.]q16-dev)$/) { print "Unexpected removal: " $2; exit 1 } }' \
      /opt/islet-explorer-build/system-build-tools-removal.txt; \
    apt-get remove -y python3-pip python3-setuptools python3-mako python3-wheel; \
    python3 -c 'import importlib.util; assert all(importlib.util.find_spec(p) is None for p in ("pip", "setuptools", "mako", "wheel"))'; \
    /opt/islet-explorer-py/bin/python -m pip check; \
    /opt/islet-explorer-py/bin/python -c \
      'import anndata, scanpy, igraph, leidenalg, fa2_modified; print("python trajectory dependencies: ok")'

COPY --chown=shiny:shiny app/shiny_app /srv/islet-explorer/app/shiny_app
COPY --chown=shiny:shiny app/docs/logo.png /srv/islet-explorer/app/docs/logo.png
COPY deploy/shiny-server.conf /etc/shiny-server/shiny-server.conf
COPY deploy/container-entrypoint.sh /usr/local/bin/islet-container-entrypoint
COPY deploy/r-worker.py /usr/local/bin/islet-r-worker

RUN set -eux; \
    rm -f \
      /srv/islet-explorer/app/shiny_app/.Renviron \
      /srv/islet-explorer/app/shiny_app/.Rhistory \
      /srv/islet-explorer/app/shiny_app/APP_LOADED_FLAG \
      /srv/islet-explorer/app/shiny_app/R/APP_LOADED_FLAG; \
    rm -rf /srv/islet-explorer/app/shiny_app/www/local_images; \
    mkdir -p \
      /srv/islet-explorer/app/shiny_app/www/local_images \
      /srv/islet-explorer/data \
      /var/log/shiny-server; \
    rm -f /srv/islet-explorer/app/shiny_app/www/logo.png; \
    ln -s ../../docs/logo.png /srv/islet-explorer/app/shiny_app/www/logo.png; \
    chmod 0755 /usr/local/bin/islet-container-entrypoint; \
    chmod 0555 /usr/local/bin/islet-r-worker; \
    chown -R shiny:shiny /srv/islet-explorer /var/log/shiny-server /opt/islet-explorer-py; \
    Rscript -e 'stopifnot(all(vapply(c("shiny", "destiny", "duckdb", "sf", "magick", "reticulate"), requireNamespace, logical(1), quietly=TRUE))); p <- as.data.frame(installed.packages(fields="Repository")[, c("Package", "Version", "LibPath", "Repository"), drop=FALSE]); p <- p[order(p$Package), ]; write.table(p, "/opt/islet-explorer-build/R-packages.tsv", sep="\t", row.names=FALSE, quote=FALSE, na="")'; \
    chmod 0444 /opt/islet-explorer-build/R-packages.tsv

WORKDIR /srv/islet-explorer/app/shiny_app
USER shiny

EXPOSE 3838
HEALTHCHECK --interval=30s --timeout=10s --start-period=180s --retries=5 \
  CMD curl --fail --silent --show-error --max-time 8 \
      http://127.0.0.1:3838/islet-explorer/ >/dev/null || exit 1

ENTRYPOINT ["/usr/local/bin/islet-container-entrypoint"]
CMD ["/usr/bin/shiny-server"]

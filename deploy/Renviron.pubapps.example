# Non-secret production environment contract. The Quadlet unit sets these
# values directly, so a .Renviron file is normally unnecessary. This example is
# useful for an RC-managed equivalent unit. Never add KEY, OPENAI_API_KEY, BASE,
# or any other credential/AI endpoint to the reviewer deployment.
ISLET_RUNTIME_MODE=production
ISLET_ENABLE_AI=FALSE
SHOW_STATISTICS_TAB=0
SHOW_INFLAMMATION_TAB=0
DEBUG_CREDENTIALS=0
VIEWER_DEBUG=0
ISLET_DATA_ROOT=/srv/islet-explorer/data
LOCAL_IMAGE_ROOT=/srv/islet-explorer/app/shiny_app/www/local_images
RETICULATE_PYTHON=/opt/islet-explorer-py/bin/python
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
NUMEXPR_NUM_THREADS=1

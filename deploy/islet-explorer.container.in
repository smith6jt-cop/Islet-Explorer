[Unit]
Description=Islet Explorer @@INSTANCE@@ (@@RELEASE@@)
Wants=network-online.target
After=network-online.target
RequiresMountsFor=@@DATA_DIR@@ @@IMAGE_DIR@@ @@LOG_DIR@@ @@TMP_DIR@@@@LOCAL_DATA_MOUNT@@

[Container]
ContainerName=@@INSTANCE@@
Image=@@IMAGE_REF@@
Pull=never

# Rootless keep-id maps the PubApps service account to the image's existing
# shiny UID/GID. The entrypoint verifies the mapping and directory permissions.
UserNS=keep-id:uid=@@CONTAINER_UID@@,gid=@@CONTAINER_GID@@
User=@@CONTAINER_UID@@:@@CONTAINER_GID@@

# Shiny listens on the container interface; the VM publishes one address and
# port per instance: the loopback by default, or the private VM address UFRC's
# TLS/Basic-Auth reverse proxy connects to (activate-release.sh
# --publish-address), which UFRC's network keeps from every other host.
PublishPort=@@PUBLISH_ADDRESS@@:@@PORT@@:3838

Volume=@@DATA_DIR@@:/srv/islet-explorer/data:ro
@@LOCAL_DATA_VOLUMES@@
Volume=@@IMAGE_DIR@@:/srv/islet-explorer/app/shiny_app/www/local_images:ro
Volume=@@LOG_DIR@@:/var/log/shiny-server:rw
Volume=@@TMP_DIR@@:/tmp/islet-explorer:rw
# U chowns each tmpfs to the container user (Podman 4.9 and 5.8 alike); the
# uid=/gid= options are rejected by both as invalid mount options.
Tmpfs=/run:rw,size=16m,mode=0755,U
Tmpfs=/var/lib/shiny-server:rw,size=64m,mode=0755,U

ReadOnly=true
NoNewPrivileges=true
DropCapability=all
PodmanArgs=@@CPU_LIMIT@@--memory=@@MEMORY@@ --pids-limit=2048

Environment=ISLET_RELEASE=@@RELEASE@@
Environment=ISLET_RUNTIME_MODE=production
Environment=ISLET_DATA_ROOT=/srv/islet-explorer/data
Environment=ISLET_DATA_SCHEMA=@@DATA_SCHEMA@@
Environment=LOCAL_IMAGE_ROOT=/srv/islet-explorer/app/shiny_app/www/local_images
Environment=RETICULATE_PYTHON=/opt/islet-explorer-py/bin/python
Environment=ISLET_ENABLE_AI=FALSE
Environment=SHOW_STATISTICS_TAB=0
Environment=SHOW_INFLAMMATION_TAB=0
Environment=DEBUG_CREDENTIALS=0
Environment=VIEWER_DEBUG=0
Environment=TMPDIR=/tmp/islet-explorer
# The entrypoint derives and creates these under TMPDIR for the service; set
# here too so a `podman exec` (the deployment verifier's dependency probe) finds
# writable caches on the read-only root instead of failing numba's import.
Environment=R_USER=/tmp/islet-explorer/r-user
Environment=XDG_CACHE_HOME=/tmp/islet-explorer/cache
Environment=MPLCONFIGDIR=/tmp/islet-explorer/matplotlib
Environment=NUMBA_CACHE_DIR=/tmp/islet-explorer/numba
Environment=OMP_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
Environment=MKL_NUM_THREADS=1
Environment=NUMEXPR_NUM_THREADS=1

HealthCmd=curl --fail --silent --show-error --max-time 8 http://127.0.0.1:3838/islet-explorer/
HealthInterval=30s
HealthOnFailure=kill
HealthRetries=5
HealthStartPeriod=180s
HealthTimeout=10s

[Service]
Restart=on-failure
RestartSec=10s
# `systemctl --user stop` sends SIGTERM; Shiny Server exits 143 on it, which systemd otherwise records as
# "failed (exit-code)" (owner stop test, 2026-10-26). Treated as a clean exit, a stopped unit reads "inactive".
SuccessExitStatus=143
TimeoutStartSec=240s
TimeoutStopSec=60s

[Install]
WantedBy=default.target

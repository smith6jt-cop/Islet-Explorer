  "query": "SELECT disease_status, count(*) AS all_cells, count(*) FILTER (WHERE phenotype='Doublet suspected') AS doublet_suspected, count(*) FILTER (WHERE phenotype='Unclassified') AS unclassified, count(*) FILTER (WHERE phenotype IN ('Endocrine','Acinar','Endothelial','T cell','Immune','Hematopoietic CD45+','Hematopoietic CD45-','Unknown','ECAD+','Structural','APCs')) AS no_subtype FROM cells LEFT JOIN donors USING(case_id) GROUP BY disease_status ORDER BY CASE disease_status WHEN 'ND' THEN 1 WHEN 'Aab+' THEN 2 WHEN 'T1D' THEN 3 ELSE 4 END"

# Data and large binary outputs.
# `data/*` rather than `data/`: git never descends into an excluded DIRECTORY, so
# a `!data/file` negation is silently ignored under the `data/` form. With
# `data/*` the small, reviewable provenance CSVs below can be re-included by name
# (the two gate files were previously force-added, which left no record of why
# they were tracked). Everything else under data/ -- h5ad, per-islet CSVs,
# geojson, the 2.65M-row cell_distance.csv -- stays ignored.
data/*
!data/phenotype_gates_per_image.csv
!data/phenotype_gates_provenance.csv
!data/donor_metadata.csv
# Referenced from CLAUDE.md as the canonical lineage doc but never actually
# tracked -- the blanket data/ rule kept it out of every clone.
!data/DATA_PROVENANCE.md
# Repo-root QuPath per-compartment means export (11 GB) -- never commit; regenerated by QuPath.
/CellCompartments.tsv
pdfs/
*.pdf
*.Rout
gson/
single_cell_analysis/*.h5ad
single_cell_analysis/*.tsv
app/shiny_app/www/local_images/
local_images/
app/shiny_app/www/segmentation_data/
AI_Markdown/
analysis_output/*
# Same pattern as data/*: git never descends into an excluded DIRECTORY, so a
# !islet_analysis/CLAUDE.md negation is inert under the bare directory form. The
# root CLAUDE.md cites this file as the canonical reference for the Python
# analysis pipeline, but the blanket rule kept it out of every clone. Everything
# else here (h5ad, tsv, png, .venv) stays ignored.
islet_analysis/*
!islet_analysis/CLAUDE.md
literature/*

# R workspace and environment files
.RData
.Rhistory
app/shiny_app/.Renviron
.Renviron

# Organized script directories (duplicates for organization)
scripts/Python/
scripts/R_files/
scripts/Shell_scripts/

# Notebook execution outputs
notebooks/*_executed.ipynb
notebooks/*.png

# App runtime flags
app/shiny_app/APP_LOADED_FLAG
app/shiny_app/R/APP_LOADED_FLAG

# Temporary files
tmp/

# Virtual environments and caches
.venv*/
venv*/
__pycache__/
*.pyc
node_modules/

# Excel and other large source data
*.xlsx
*.xls
*.xlsm

# IDE and local configs
.vscode/
.DS_Store
.~lock.*#

# Tool downloads (large jars)
scripts/tools/

# Large package files
*.deb
*.rpm
scripts/scvi_comparison_results/new_latent_single_cell.npy

# Apptainer/Singularity images (built artifacts, multi-GB)
*.sif

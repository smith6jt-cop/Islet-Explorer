 # cohort-wide only if NO donor has an adequate positive cluster.
 PREVALENCE_COLLAPSE_MARKERS = ("KRT14", "CD35", "CD20", "SST", "GAP43")
 
+# --- Adaptive (outlier-robust) RESTORE divisor (2026-07-24, image review) ------------------------
+# Upstream's divisor is the raw MAXIMUM of the reference-positive/target-negative control
+# (negative_control_statistics: `divisor = values.max()`), and positivity is `value > divisor`. That
+# is outlier-fragile: ONE contaminating bright cell in the control (e.g. an ECAD+ ductal cell with
+# T1D-upregulated HLA-II, or a bright artifact) pins the divisor at ~p99.99 of the marker, so EVERY
+# real positive below it is uncalled -> a ZERO call for a marker that is present in every image. That
+# is a method failure, not biology (user directive: "there should never be a zero for any marker").
+#
+# FIX: keep the control max by default (so the reviewer-accepted clean pairs are unchanged -- their
+# control max is only ~1.4-2.5x their q99), but when the max is an EXTREME OUTLIER relative to the
+# control's own q99 (the contamination signature: HLADR 6521 max/q99 = 18x, PDPN 6479 = 175x), fall
+# back to a robust control quantile. Self-contained in the control values, so it drops into
+# negative_control_statistics (patched CODEX-side; see codex_restore_validation.patch_upstream).
+DIVISOR_OUTLIER_K = 5.0            # max > K * q99(control) => contaminated => use the fallback quantile
+DIVISOR_Q99 = 0.99                # the outlier-detection reference quantile
+DIVISOR_FALLBACK_QUANTILE = 0.995  # the robust divisor when the control is contaminated
+
+
+def robust_control_divisor(values):
+    """Adaptive RESTORE divisor: control max, unless max is an extreme outlier (contamination) ->
+    control q99.5. Returns (divisor, robustified). Fixes the 'zero call for a present marker' failure.
+    """
+    import numpy as np
+    v = np.asarray(values, dtype=float)
+    v = v[np.isfinite(v)]
+    if v.size == 0:
+        raise ValueError("negative-control population is empty")
+    mx = float(v.max())
+    q99 = float(np.quantile(v, DIVISOR_Q99))
+    if q99 > 0 and mx > DIVISOR_OUTLIER_K * q99:
+        return float(np.quantile(v, DIVISOR_FALLBACK_QUANTILE)), True
+    return mx, False
+

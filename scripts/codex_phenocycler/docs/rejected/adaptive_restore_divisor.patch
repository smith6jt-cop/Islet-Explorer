--- a/scripts/codex_phenocycler/codex_restore_validation.py
+++ b/scripts/codex_phenocycler/codex_restore_validation.py
@@ -93,6 +93,32 @@ def _upstream_sha() -> str | None:
         return None
 
 
+def _codex_negative_control_statistics(values):
+    """CODEX-adaptive replacement for rv.negative_control_statistics (the divisor computation).
+
+    Upstream uses the control MAXIMUM as the divisor, which one contaminating bright cell inflates to
+    ~p99.99 -> a zero call for a present marker (HLADR/PDPN). This keeps the max for clean controls but
+    falls back to the control q99.5 when the max is an extreme outlier (cl.robust_control_divisor).
+    The `normalize <= 1` assertion is only enforced when the max is used (a quantile divisor legitimately
+    has control cells above it). Same return keys as upstream so every caller is unaffected.
+    """
+    import numpy as np
+    v = np.asarray(values, dtype=float)
+    v = v[np.isfinite(v)]
+    if v.size == 0:
+        raise ValueError("negative-control population is empty")
+    if np.any(v < 0):
+        raise ValueError("RESTORE requires nonnegative linear intensities")
+    divisor, robustified = cl.robust_control_divisor(v)
+    if divisor <= 0:
+        raise ValueError("negative-control divisor must be positive")
+    if not robustified and np.any(v / divisor > 1 + 1e-12):
+        raise AssertionError("negative controls must normalize to <= 1")
+    return {"n": int(v.size), "maximum": divisor,
+            "mean_plus_3sd": float(v.mean() + 3.0 * v.std(ddof=0)),
+            "median": float(np.median(v)), "p95": float(np.quantile(v, 0.95))}
+
+

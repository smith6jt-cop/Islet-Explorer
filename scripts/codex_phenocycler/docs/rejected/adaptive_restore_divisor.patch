diff --git a/scripts/codex_phenocycler/test_codex_restore_validation.py b/scripts/codex_phenocycler/test_codex_restore_validation.py
index a4ed108..c4d430e 100644
--- a/scripts/codex_phenocycler/test_codex_restore_validation.py
+++ b/scripts/codex_phenocycler/test_codex_restore_validation.py
@@ -95,6 +95,21 @@ def test_faithful_feature_space_not_cell_only():
     assert rv.PairValidationConfig().feature_compartments == ("Membrane", "Cell")
 
 
+def test_adaptive_divisor_robustifies_only_outliers():
+    import numpy as np
+    rng = np.random.default_rng(0)
+    clean = rng.gamma(2.0, 100.0, 5000)
+    div_clean, robustified = cl.robust_control_divisor(clean)
+    assert not robustified and div_clean == float(clean.max()), "clean control must keep the max"
+    contaminated = np.append(clean, clean.max() * 30.0)   # one 30x outlier
+    div_cont, robustified = cl.robust_control_divisor(contaminated)
+    assert robustified and div_cont < float(contaminated.max()), "an outlier control must fall back"
+    assert div_cont == float(np.quantile(contaminated, cl.DIVISOR_FALLBACK_QUANTILE))
+    # the patched scorer must be installed by patch_upstream (so every screen uses it)
+    crv.patch_upstream()
+    assert rv.negative_control_statistics.__name__ == "_codex_negative_control_statistics"
+
+
